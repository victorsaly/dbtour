{
  "name": "dbtour",
  "version": "0.9.2",
  "description": "Tour your database and its API: searchable docs, relations and diagrams, generated from the schema, kept in the repo.",
  "type": "module",
  "license": "MIT",
  "author": "Victor Saly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "dbtour": "bin/dbtour.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./markdown": {
      "types": "./dist/render/markdown.d.ts",
      "default": "./dist/render/markdown.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "database",
    "documentation",
    "schema",
    "erd",
    "mssql",
    "markdown",
    "mermaid"
  ],
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
