{
  "name": "dbtour",
  "version": "0.10.2",
  "description": "Schema docs for your database, kept in your repository: Markdown with Mermaid diagrams, a searchable one-file page, and an MCP server so agents write SQL from the real names. Read from the catalogue, never the rows.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Victor Saly",
    "url": "https://github.com/victorsaly"
  },
  "homepage": "https://github.com/victorsaly/dbtour#readme",
  "bugs": {
    "url": "https://github.com/victorsaly/dbtour/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "dbtour": "bin/dbtour.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./markdown": {
      "types": "./dist/render/markdown.d.ts",
      "default": "./dist/render/markdown.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "database",
    "schema",
    "documentation",
    "data-dictionary",
    "erd",
    "mermaid",
    "markdown",
    "sql-server",
    "mssql",
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
