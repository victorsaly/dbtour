  "description": "SQL Server source for dbtour: tables, views, columns, keys, relations, indexes, descriptions.",
  "type": "module",
  "license": "MIT",
  "author": "Victor Saly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
