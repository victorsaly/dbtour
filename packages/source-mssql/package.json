{
  "name": "dbtour-source-mssql",
  "version": "0.9.5",
  "description": "SQL Server source for dbtour: tables, views, keys, relations, indexes, row counts and extended properties, read from the catalogue with VIEW DEFINITION alone, never the rows.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Victor Saly",
    "url": "https://github.com/victorsaly"
  },
  "homepage": "https://github.com/victorsaly/dbtour#readme",
  "bugs": {
    "url": "https://github.com/victorsaly/dbtour/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
    "directory": "packages/source-mssql"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "dbtour",
    "sql-server",
    "mssql",
    "azure-sql",
    "schema",
    "extended-properties",
    "data-dictionary"
  ],
  "dependencies": {
    "mssql": "^12.7.13"
  },
  "peerDependencies": {
    "dbtour": "0.9.5"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "dbtour": "0.9.5"
  }
}
