{
  // The page is browser code that esbuild bundles, so unlike the rest of the repository it may use JSX and
  // the DOM. Same module rules as the root: real .ts names in imports, nothing emitted.
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/page/**/*.ts", "src/page/**/*.tsx"]
}
