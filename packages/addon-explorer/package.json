{
  "name": "dbtour-addon-explorer",
  "version": "0.9.5",
  "description": "The dbtour page: your schema as one HTML file that opens without a server, with search, an entry per table, relation maps and a SQL editor that checks names against the model.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Victor Saly",
    "url": "https://github.com/victorsaly"
  },
  "homepage": "https://github.com/victorsaly/dbtour#readme",
  "bugs": {
    "url": "https://github.com/victorsaly/dbtour/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
    "directory": "packages/addon-explorer"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts/OFL-Archivo.txt",
    "fonts/OFL-RedHatMono.txt"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepack": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "dbtour",
    "database",
    "schema",
    "documentation",
    "erd",
    "data-dictionary",
    "sql-editor"
  ],
  "peerDependencies": {
    "dbtour": "0.9.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.0",
    "dbtour": "0.9.5",
    "elkjs": "^0.12.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.9.0"
  }
}
