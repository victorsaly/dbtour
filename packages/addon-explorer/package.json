{
  "name": "dbtour-addon-explorer",
  "version": "0.7.0",
  "description": "The dbtour page: search, table view and neighbourhood diagrams in one HTML file that opens without a server.",
  "type": "module",
  "license": "MIT",
  "author": "Victor Saly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
    "directory": "packages/addon-explorer"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts/OFL-Archivo.txt",
    "fonts/OFL-RedHatMono.txt"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "prepack": "node ../../scripts/build.mjs"
  },
