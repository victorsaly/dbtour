{
  "name": "dbtour-source-sqlite",
  "version": "0.11.1",
  "description": "SQLite source for dbtour: tables, views, keys, relations, indexes, triggers, sizes and the comments in each CREATE, read from a file opened read-only, with nothing to install.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Victor Saly",
    "url": "https://github.com/victorsaly"
  },
  "homepage": "https://github.com/victorsaly/dbtour#readme",
  "bugs": {
    "url": "https://github.com/victorsaly/dbtour/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsaly/dbtour.git",
    "directory": "packages/source-sqlite"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build.mjs"
  },
  "keywords": [
    "dbtour",
    "sqlite",
    "schema",
    "data-dictionary",
    "database-documentation",
    "erd",
    "node-sqlite"
  ],
  "peerDependencies": {
    "dbtour": "0.11.1"
  },
  "devDependencies": {
    "dbtour": "0.11.1"
  }
}
