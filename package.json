{
  "name": "dbtour-monorepo",
  "private": true,
  "type": "module",
  "description": "Development root for dbtour. The packages are in packages/.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test 'packages/*/test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='packages/*/src/**/*.ts' --test-coverage-exclude='packages/*/src/cli.ts' --test-coverage-lines=90 --test-coverage-branches=80 'packages/*/test/**/*.test.ts'",
    "test:e2e": "node --test 'packages/*/test/e2e/*.e2e.ts'",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "example": "cd examples/shop && node ../../packages/core/bin/dbtour.mjs render",
    "e2e:mssql": "node scripts/e2e-mssql.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
