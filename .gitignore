node_modules
.DS_Store
# What `npm run example` renders; the example's schema.json is kept.
examples/*/docs/README.md
examples/*/docs/tables/
examples/*/docs/index.html
# What `npm run build` bundles for the page.
packages/*/dist/
# The licence the build copies into each package for npm; the repository's is the one kept.
packages/*/LICENSE
# SideShot's pictures of a pull request; the published ones live on the sideshot branch.
.sideshot/
# The design skill's working captures; its records (design.json, the surface briefs) are kept.
.impeccable/review/
.impeccable/build/
.impeccable/mocks/
.impeccable/questions/

# What claude plugin eval writes; the cases themselves are committed.
evals/results/
